prefix=${pcfiledir}/@SAA_PC_TO_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: saaclient
Description: C client for the hosted SAA streaming service
Version: @PROJECT_VERSION@
@SAA_PC_REQUIRES@
Libs: -L${libdir} -lsaaclient @SAA_PC_LIBS@
@SAA_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
